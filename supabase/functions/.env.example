RIOT_API_KEY=your-riot-development-key
ALLOWED_ORIGINS=http://localhost:5173
# Optional: choose a valid version from https://ddragon.leagueoflegends.com/api/versions.json
DDRAGON_VERSION=
# Enable only after verifying the deployment proxy overwrites a single-address header.
# Leave both blank locally; global/key/Riot limits still apply.
VERIFIED_CLIENT_IP_HEADER=
CLIENT_IP_HASH_SALT=
